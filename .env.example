# Copy to .env and fill in your real values (see task.md).

# Neon (or any Postgres) connection strings.
# DATABASE_URL - pooled connection string, used by the app at runtime on serverless.
# DIRECT_URL   - unpooled connection string, used by Prisma CLI for migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# EmailJS (contact form email delivery) - optional, falls back to DB persistence.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=""

# Gmail SMTP (nodemailer) for contact form email delivery.
# Use a Google App Password, not your normal account password.
# https://myaccount.google.com/apppasswords
GMAIL_USER="your.email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
# Name shown as the sender on the auto-reply to visitors.
MAIL_FROM_NAME="Rahul"

# Admin dashboard session signing. Use a long random string.
# Create your admin login with: npm run db:create-admin -- --email you@example.com --password secret
SESSION_SECRET=""